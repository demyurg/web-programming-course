{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src"]
}
// правила для проверки тайпскрипта, что бы не использовать проверку по умолчанию
// не будут учитывааться какието ошибки 
// strict будет выключен 
// стрикт:  
// нельзя использовать переменные без значения 
// нельзя передавать не тот тип данных 
// нельзя игнорировать возможные ошибки
// npm run check может работать медленнее